APP_ENV=development
APP_NAME=DPM ONE API
DATABASE_URL=postgresql+psycopg://dpmone:CHANGE_DB_PASSWORD@db:5432/dpmone
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30

# One-time initial admin bootstrap values. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=DPM Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_14_OR_MORE_CHARACTERS
